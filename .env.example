# Google AI (Gemini) API Key - FREE tier available
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Cloudflare Workers AI - FREE (image generation with flux-1-schnell)
# Get from: https://dash.cloudflare.com/profile/api-tokens
# Account ID: Cloudflare Dashboard > right sidebar
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Cloudflare R2 (image storage — replaces local public/images/posts/)
# 1. Cloudflare Dashboard > R2 > Create bucket
# 2. Bucket settings > Enable public access  →  copy the pub-xxx.r2.dev URL
# 3. Manage R2 API Tokens > Create Token (Object Read & Write on this bucket)
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Google Analytics 4 Measurement ID
# Get from: Google Analytics > Admin > Data Streams > Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Threads API (for auto-posting)
# Get from: Meta Developer Portal > Your App > Threads API
# 1. Create app at https://developers.facebook.com/
# 2. Add Threads API product
# 3. Connect Instagram Business account
# 4. Generate long-lived access token
THREADS_USER_ID=your-threads-user-id
THREADS_ACCESS_TOKEN=your-long-lived-access-token

# Twitter/X API (Free tier: 1,500 posts/month)
# Get from: https://developer.x.com/en/portal/dashboard
# 1. Create a project and app
# 2. Enable OAuth 1.0a with Read and Write permissions
# 3. Generate access token and secret
TWITTER_APP_KEY=your-app-key
TWITTER_APP_SECRET=your-app-secret
TWITTER_ACCESS_TOKEN=your-access-token
TWITTER_ACCESS_SECRET=your-access-secret

# Bluesky (AT Protocol - Free)
# 1. Go to https://bsky.app/settings/app-passwords
# 2. Create an app password
BLUESKY_IDENTIFIER=your-handle.bsky.social
BLUESKY_PASSWORD=your-app-password

# Reddit API (for auto-posting to r/kpop, r/kdrama, fandom subreddits)
# 1. Go to https://www.reddit.com/prefs/apps
# 2. Click "create another app..." → type: script
# 3. Note the client_id (under app name) and client_secret
REDDIT_CLIENT_ID=your-client-id
REDDIT_CLIENT_SECRET=your-client-secret
REDDIT_USERNAME=your-reddit-username
REDDIT_PASSWORD=your-reddit-password

# Discord Webhook (for auto-posting to Discord server)
# 1. Discord server → channel settings → Integrations → Webhooks → New Webhook
# 2. Copy the webhook URL
DISCORD_WEBHOOK_URL=your-webhook-url
