{
  "name": "kpop-blog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "generate-feeds": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/generate-feeds.ts",
    "build": "npm run generate-feeds && next build",
    "start": "next start",
    "lint": "next lint",
    "fetch-news": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/fetch-news.ts",
    "post-threads": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/post-threads.ts",
    "post-backlog": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/post-backlog.ts",
    "post-twitter": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/post-twitter.ts",
    "post-bluesky": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/post-bluesky.ts",
    "generate": "npm run fetch-news && npm run build",
    "generate-and-post": "npm run fetch-news && npm run post-threads && npm run post-twitter && npm run post-bluesky && npm run build"
  },
  "dependencies": {
    "@atproto/api": "^0.18.20",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "autoprefixer": "^10.4.23",
    "cheerio": "^1.0.0-rc.12",
    "date-fns": "^4.1.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.562.0",
    "next": "^14.2.35",
    "node-fetch": "^2.7.0",
    "openai": "^4.28.0",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rss-parser": "^3.13.0",
    "twitter-api-v2": "^1.29.0",
    "typescript": "^5.9.3",
    "unsplash-js": "^7.0.20"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2"
  }
}
